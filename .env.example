# ==========================================
# NEXT AI PROXY HUB ENVIRONMENT CONFIGURATION
# ==========================================

# Server & Proxy
NODE_ENV=development
PORT=12345
HOST=0.0.0.0
PUBLIC_API_BASE_URL=http://localhost:12345/v1
# Upstream Gateway (New API Gateway)
# Default connects to the local New API gateway instance at http://127.0.0.1:3000/v1
NEWAPI_BASE_URL=http://127.0.0.1:3000/v1
UPSTREAM_BASE_URL=http://127.0.0.1:3000/v1
NEWAPI_PUBLIC_ENDPOINT=http://127.0.0.1:3000/v1
NEWAPI_ADMIN_ACCESS_TOKEN=your_newapi_admin_access_token_here

# Architecture Deprecation: Disable Node.js reverse proxy to prevent duplicate gateway layer
# Customers route directly to New API. Default: false
ENABLE_LEGACY_PROXY=false

# Security & Secrets
# 32-byte hex key for encrypting upstream API keys (AES-256-GCM)
# Required in production; defaults to development placeholder in dev/test
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upstream New API Group-Specific API Keys (Strict 1:1 Group Association)
# - NxG1 -> Group A key
# - NxGE -> Group E key
# - NxGC -> Claude key
NEWAPI_API_KEY_GROUP_A=your_newapi_group_a_api_key_here
NEWAPI_API_KEY_GROUP_E=your_newapi_group_e_api_key_here
NEWAPI_API_KEY_GROUP_CLAUDE=your_newapi_group_claude_api_key_here

# Deprecated Upstream Bearlab Keys (Preserved for backwards compatibility, not used in New API path)
# BEARLAB_API_KEY_GROUP_A=your_bearlab_group_a_api_key_here
# BEARLAB_API_KEY_GROUP_E=your_bearlab_group_e_api_key_here
# BEARLAB_API_KEY_GROUP_CLAUDE=your_bearlab_group_claude_api_key_here

# Database
# Default PostgreSQL connection string. For local zero-dependency testing, SQLite can also be used.
DATABASE_URL="file:./dev.db"

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Discord Ticket Management Channels
# TICKET_PANEL_CHANNEL_ID: Where customers can view the Support Center and open tickets
TICKET_PANEL_CHANNEL_ID=1566827188534378617
# TICKET_LOG_CHANNEL_ID: Where the bot records ticket activity logs
TICKET_LOG_CHANNEL_ID=1566804177848369286
# PromptPay recipient ID (Mobile phone number or National ID / Tax ID)
PROMPTPAY_ID=0926671327
# Category channel ID under which private tickets are created (optional; creates under root if blank)
DISCORD_TICKET_CATEGORY_ID=your_ticket_category_channel_id
# Channel where admin payment review panels are posted
DISCORD_ADMIN_REVIEW_CHANNEL_ID=your_admin_review_channel_id

# Support Role ID (Authorized staff role for ticket management)
SUPPORT_ROLE_ID=your_support_role_id_here

# Admin Allowlist (Comma-separated Discord User IDs)
DISCORD_ADMIN_USER_IDS=123456789012345678,987654321098765432

# Exchange Rate (Frankfurter API)
FRANKFURTER_API_BASE=https://api.frankfurter.dev/v2
EXCHANGE_RATE_CACHE_TTL_MINUTES=60
EXCHANGE_RATE_MAX_STALE_HOURS=24
FX_SPREAD_PERCENT=0.0

# Storage for Payment Slips
SLIP_STORAGE_DIR=./storage/slips
MAX_SLIP_SIZE_MB=10
